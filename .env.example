# Example environment for running components locally.
# Copy to .env and adjust. NEVER commit a real .env (see .gitignore).

# PostgreSQL DSN for the registry service (bridge-registry-service).
# Local file-based storage is the default when PG_DSN is unset.
DATABASE_URL=file:./db/custom.db
# PG_DSN=postgres://bridge:bridge@localhost:5432/bridge

# Dashboard (dashboard/README.md has the full list):
# NEXT_PUBLIC_REGISTRY_URL=http://localhost:4350
# NEXT_PUBLIC_DEMO_MODE=false

# Dashboard login gate (issue #163) — OIDC authorization-code + PKCE.
# Required in production builds unless AUTH_DISABLED=true is set explicitly.
# OIDC_ISSUER=https://id.example.com/
# OIDC_CLIENT_ID=bridge-console
# OIDC_CLIENT_SECRET=<from your provider>
# SESSION_SECRET=<openssl rand -hex 32>
# Optional: pin the callback when the edge does not forward host/proto.
# OIDC_REDIRECT_URI=https://localhost:3000/api/auth/callback
# Explicitly turn the gate off for public demo deployments only (logged loudly):
# AUTH_DISABLED=true
