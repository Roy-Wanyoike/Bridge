coverage/
.nyc_output/
*.lcov

# Environment & secrets — NEVER commit
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/

# Sandbox / workspace artifacts (not part of the project)
download/
upload/
skills/
db/
agent-ctx/
worklog.md
*.log
logs/

# Editor & OS
.vscode/
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

