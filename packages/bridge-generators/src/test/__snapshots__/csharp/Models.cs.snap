/// <summary>
/// Resolution is a tagged union of possible dispute outcomes.
/// Wire format: {"kind": "&lt;variant&gt;", "value": &lt;payload&gt;}.
/// </summary>
public sealed class Resolution
{
    public string Kind { get; set; }
    public object? Value { get; set; }

    public static Resolution Refund(Money value) {
        return new Resolution { Kind = "refund", Value = value };
    }

    public Money? AsRefund() {
        return Kind == "refund" ? (Money) Value : null;
    }

    public static Resolution Failure(string value) {
        return new Resolution { Kind = "failure", Value = value };
    }

    public string? AsFailure() {
        return Kind == "failure" ? (string) Value : null;
    }

    public static Resolution Retry(bool value) {
        return new Resolution { Kind = "retry", Value = value };
    }

    public bool? AsRetry() {
        return Kind == "retry" ? (bool) Value : null;
    }

    /// <summary>Serializes to the Bridge wire representation.</summary>
    public Dictionary<string, object> ToDict()
    {
        var outDict = new Dictionary<string, object> { { "kind", Kind } };
        if (Value is null) { outDict["value"] = null!; return outDict; }
        if (Kind == "refund") { outDict["value"] = ((Money)Value).ToDict(); return outDict; }
        if (Kind == "failure") { outDict["value"] = ((string)Value); return outDict; }
        if (Kind == "retry") { outDict["value"] = ((bool)Value); return outDict; }
        outDict["value"] = Value;
        return outDict;
    }

    /// <summary>
    /// Decodes from the Bridge wire representation; throws
    /// ArgumentException on unknown kinds or bad payloads.
    /// </summary>
    public static Resolution FromDict(JsonElement root)
    {
        var kind = BridgeJson.expectString(root.GetProperty("kind"), "Kind");
        root.TryGetProperty("value", out var rawValue);
        if (kind == "refund") {
            return Refund(Money.FromDict(BridgeJson.expectObject(rawValue, "Value")));
        }
        if (kind == "failure") {
            return Failure(BridgeJson.expectString(rawValue, "Value"));
        }
        if (kind == "retry") {
            return Retry(BridgeJson.expectBool(rawValue, "Value"));
        }
        throw new ArgumentException("Unknown Resolution kind: " + kind);
    }

    public bool Equals(Resolution? other) {
        return other is not null && Kind == other.Kind && BridgeJson.DeepEquals(Value, other.Value);
    }

    public override bool Equals(object? other) {
        return other is Resolution o && Equals(o);
    }

    public override int GetHashCode() {
        return BridgeJson.DeepHashCode(this.ToDict());
    }
}
