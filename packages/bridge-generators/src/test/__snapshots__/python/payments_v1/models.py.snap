@dataclass
class Resolution:
    """
    Resolution is a tagged union of possible dispute outcomes.
    Wire format: {"kind": "<variant>", "value": <payload>}.
    """
    kind: str
    value: Any

    @classmethod
    def refund(cls, value: Money) -> "Resolution":
        return cls(kind="refund", value=value)

    @classmethod
    def failure(cls, value: str) -> "Resolution":
        return cls(kind="failure", value=value)

    @classmethod
    def retry(cls, value: bool) -> "Resolution":
        return cls(kind="retry", value=value)

    def to_dict(self) -> "dict[str, Any]":
        out: "dict[str, Any]" = {"kind": self.kind}
        v = self.value
        if self.kind == "refund":
            out["value"] = v.to_dict()
            return out
        if self.kind == "failure":
            out["value"] = v
            return out
        if self.kind == "retry":
            out["value"] = v
            return out
        out["value"] = v
        return out

    @classmethod
    def from_dict(cls, raw_data: "dict[str, Any]") -> "Resolution":
        kind = raw_data.get("kind")
        raw_value = raw_data.get("value")
        if kind == "refund":
            return cls(kind="refund", value=Money.from_dict(raw_value))
        if kind == "failure":
            return cls(kind="failure", value=raw_value)
        if kind == "retry":
            return cls(kind="retry", value=raw_value)
        raise ValueError(f"Unknown {type.__name__} kind: {kind!r}")

