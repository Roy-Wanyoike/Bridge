{
  "name": "@bridge/registry-service",
  "version": "0.2.1",
  "description": "Bridge registry service: multi-tenant HTTP registry API with OIDC auth, artifact signing, audit logs, rate limiting and pluggable storage (in-memory / PostgreSQL)",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "bridge-registry-service": "dist/bin/bridge-registry-service.js"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -b .",
    "test": "tsc -b . && node --test \"dist/test/*.test.js\"",
    "start": "node dist/bin/bridge-registry-service.js"
  },
  "dependencies": {
    "@bridge/compat": "*",
    "@bridge/core": "*",
    "@bridge/registry": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}
